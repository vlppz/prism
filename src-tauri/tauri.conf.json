{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "0.1.2",
  "identifier": "app.prism.vpn",
  "build": {
    "beforeDevCommand": "node ../scripts/prepare-sidecars.mjs && pnpm --dir ../ui dev",
    "beforeBuildCommand": "node ../scripts/prepare-sidecars.mjs --release && pnpm --dir ../ui build",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Prism",
        "width": 380,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#050505",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.country.is"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "One-button WireGuard that gets past DPI",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
